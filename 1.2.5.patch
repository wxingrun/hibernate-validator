+	/**
+	 * Checks whether the given executable is a Java Record accessor method.
+	 * Record accessor methods have the same name as the record component and no parameters.
+	 *
+	 * @param executable The executable to check.
+	 *
+	 * @return {@code true} if the executable is a record accessor method, {@code false} otherwise.
+	 */
+	private static boolean isRecordAccessor(ConstrainableExecutable executable) {
+		Class<?> declaringClass = executable.getDeclaringClass();
+		if ( declaringClass == null || !declaringClass.isRecord() ) {
+			return false;
+		}
+
+		String methodName = executable.getName();
+		RecordComponent[] components = declaringClass.getRecordComponents();
+		for ( RecordComponent component : components ) {
+			if ( component.getName().equals( methodName ) ) {
+				return true;
+			}
+		}
+
 		return false;
 	}
