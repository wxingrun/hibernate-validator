+          read -ra mvn_args <<< "$MAVEN_ARGS"
+          read -ra mvn_matrix_args <<< "$MAVEN_MATRIX_ARGS"
+          ./mvnw "${mvn_args[@]}" "${mvn_matrix_args[@]}" spotless:check
